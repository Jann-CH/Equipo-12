PORT=4000

# Credenciales de la Service Account de Firebase (Project Settings > Service Accounts > Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# YouTube Data API v3 (Google Cloud Console > habilitar "YouTube Data API v3" > Credenciales > API Key)
YOUTUBE_API_KEY=

# Clave secreta para los endpoints de exportación de datos (/api/admin/export/*).
# Generá algo largo y random, y compartíselo SOLO al equipo de Data Analytics.
ADMIN_EXPORT_KEY=

# URL pública del Frontend (se usa en el link del mail de recordatorio)
APP_URL=https://equipo-12-beta.vercel.app/

# Groq (chatbot inteligente para preguntas libres) - https://console.groq.com/keys
GROQ_API_KEY=
